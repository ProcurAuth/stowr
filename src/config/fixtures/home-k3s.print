server.listen = ":8080"  # file
server.job_history_limit = 10  # default
server.access_mode = "inherit_credentials"  # default
server.log_mode = "anonymous"  # default
server.allow_full_object_fallback = false  # default
server.memory_limit_bytes = 0  # default
server.max_storage_bytes_per_request = 274877906944  # default
server.max_storage_requests_per_request = 4096  # default
server.max_range_cache_bytes = 8388608  # default
server.max_concurrent_storage_requests = 4  # default
server.max_concurrent_requests_per_storage = 2  # default
server.session_ttl_seconds = 1200  # default
server.max_stats_folders = 1000  # default
server.max_archive_entries = 10000  # default
server.max_background_storage_bytes = 274877906944  # default
server.max_background_storage_requests = 100000  # default
access.mode = "authzen"  # file
access.identity.header = "X-Identity-Token"  # file
access.identity.issuer = "issuer.example.invalid"  # file
access.identity.audience = "infra-s3"  # file
access.identity.public_keys = ["Ed25519 kid=kPrK_qmxVWaYVA9wwBF6Iuo3vVzz7TxHCTwXBygrS4k"]  # file:/run/secrets/stowr_identity_keys
access.identity.max_age = "5m"  # file
access.identity.clock_skew = "60s"  # default
access.pdp.url = "http://pdp.cluster.example.invalid:4182"  # file
access.pdp.plain_http = true  # file
access.pdp.token = <hidden>  # file:/run/secrets/stowr_pdp_token
access.pdp.timeout = "500ms"  # file
access.pdp.usage_timeout = "2s"  # default
access.pdp.cache_ttl = "30s"  # file
access.pdp.max_evaluations = 64  # file
auth "seaweedfs".provider = "s3"  # file
auth "seaweedfs".mode = "access_key"  # file
auth "seaweedfs".endpoint = "http://storage.cluster.example.invalid:8333"  # file
auth "seaweedfs".region = "home"  # file
auth "seaweedfs".access_key_id = "dummy-access-key"  # file:/run/secrets/storage_s3_access_key
auth "seaweedfs".secret_access_key = <hidden>  # file:/run/secrets/storage_s3_secret_key
auth "seaweedfs".session_token = <none>  # default
auth "seaweedfs".credentials_file = <none>  # default
auth "seaweedfs".insecure_skip_verify = false  # default
bucket "docker-registry".name = "docker-registry"  # file
bucket "docker-registry".auth = "seaweedfs"  # file
bucket "docker-registry".bucket = "docker-registry"  # file
bucket "docker-registry".permissions = ["read", "write", "delete"]  # file
bucket "docker-registry".root_prefix = ""  # default
bucket "docker-registry".max_scan_pages = 15  # file
bucket "docker-registry".encryption = ""  # default
bucket "docker-registry".quota_bytes = <none>  # default
bucket "clickhouse-system".name = "clickhouse-system"  # file
bucket "clickhouse-system".auth = "seaweedfs"  # file
bucket "clickhouse-system".bucket = "clickhouse-system"  # file
bucket "clickhouse-system".permissions = ["read", "write", "delete"]  # file
bucket "clickhouse-system".root_prefix = ""  # default
bucket "clickhouse-system".max_scan_pages = 15  # file
bucket "clickhouse-system".encryption = ""  # default
bucket "clickhouse-system".quota_bytes = <none>  # default
bucket "postgresql-system".name = "postgresql-system"  # file
bucket "postgresql-system".auth = "seaweedfs"  # file
bucket "postgresql-system".bucket = "postgresql-system"  # file
bucket "postgresql-system".permissions = ["read", "write", "delete"]  # file
bucket "postgresql-system".root_prefix = ""  # default
bucket "postgresql-system".max_scan_pages = 15  # file
bucket "postgresql-system".encryption = ""  # default
bucket "postgresql-system".quota_bytes = <none>  # default
