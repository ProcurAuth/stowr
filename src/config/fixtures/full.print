server.listen = "127.0.0.1:9090"  # file
server.job_history_limit = 20  # file
server.access_mode = "force_read_only"  # file
server.log_mode = "detailed"  # file
server.allow_full_object_fallback = true  # file
server.memory_limit_bytes = 1073741824  # file
server.max_storage_bytes_per_request = 1048576  # file
server.max_storage_requests_per_request = 10000000  # file
server.max_range_cache_bytes = 4294967296  # file
server.max_concurrent_storage_requests = 1024  # file
server.max_concurrent_requests_per_storage = 256  # file
server.session_ttl_seconds = 604800  # file
server.max_stats_folders = 1000000  # file
server.max_archive_entries = 1  # file
server.max_background_storage_bytes = 1125899906842624  # file
server.max_background_storage_requests = 1  # file
access.mode = "open"  # file
auth "storage".provider = "s3"  # file
auth "storage".mode = "access_key"  # default
auth "storage".endpoint = "https://[::1]:9000/base%20path"  # file
auth "storage".region = "eu-west-3"  # file
auth "storage".access_key_id = "AKIA-FIXTURE"  # env:FIXTURE_ACCESS_KEY
auth "storage".secret_access_key = <hidden>  # file:@DIR@/secrets/s3-secret
auth "storage".session_token = <hidden>  # env:FIXTURE_SESSION_TOKEN
auth "storage".credentials_file = <none>  # default
auth "storage".insecure_skip_verify = true  # file
auth "storage".usage.source = "seaweedfs"  # file
auth "storage".usage.endpoint = "http://master.example.invalid:9333"  # file
auth "storage".usage.filer_endpoint = "https://filer.example.invalid:8888"  # file
auth "storage".usage.token = <none>  # default
auth "garage".provider = "s3"  # file
auth "garage".mode = "access_key"  # file
auth "garage".endpoint = "http://garage.example.invalid:3900"  # file
auth "garage".region = "garage"  # file
auth "garage".access_key_id = "GK0123"  # file
auth "garage".secret_access_key = <hidden>  # env:FIXTURE_GARAGE_SECRET
auth "garage".session_token = <none>  # default
auth "garage".credentials_file = <none>  # default
auth "garage".insecure_skip_verify = false  # default
auth "garage".usage.source = "garage"  # file
auth "garage".usage.endpoint = "http://garage.example.invalid:3903"  # file
auth "garage".usage.filer_endpoint = <none>  # default
auth "garage".usage.token = <hidden>  # file:@DIR@/secrets/garage-token
auth "google".provider = "gcs"  # file
auth "google".mode = "service_account"  # default
auth "google".endpoint = "https://storage.googleapis.com"  # default
auth "google".region = <none>  # default
auth "google".access_key_id = <none>  # default
auth "google".secret_access_key = <none>  # default
auth "google".session_token = <none>  # default
auth "google".credentials_file = "@DIR@/secrets/gcs.json"  # file
auth "google".insecure_skip_verify = false  # default
auth "public-gcs".provider = "gcs"  # file
auth "public-gcs".mode = "anonymous"  # default
auth "public-gcs".endpoint = "http://gcs.example.invalid:4443/storage"  # file
auth "public-gcs".region = <none>  # default
auth "public-gcs".access_key_id = <none>  # default
auth "public-gcs".secret_access_key = <none>  # default
auth "public-gcs".session_token = <none>  # default
auth "public-gcs".credentials_file = <none>  # default
auth "public-gcs".insecure_skip_verify = false  # default
bucket "documents".name = "Documents \"main\"\u00a0é\t日本"  # file
bucket "documents".auth = "storage"  # file
bucket "documents".bucket = "documents"  # file
bucket "documents".permissions = ["read", "write"]  # file
bucket "documents".root_prefix = "tenant/a/"  # file
bucket "documents".max_scan_pages = 0  # file
bucket "documents".encryption = "sse-s3"  # file
bucket "documents".quota_bytes = 1152921504606846976  # file
bucket "empty-permissions".name = "empty-permissions"  # default
bucket "empty-permissions".auth = "garage"  # file
bucket "empty-permissions".bucket = "empty"  # file
bucket "empty-permissions".permissions = []  # file
bucket "empty-permissions".root_prefix = ""  # default
bucket "empty-permissions".max_scan_pages = 1  # default
bucket "empty-permissions".encryption = ""  # file
bucket "empty-permissions".quota_bytes = <none>  # default
bucket "photos".name = "photos"  # default
bucket "photos".auth = "google"  # file
bucket "photos".bucket = "photos.example"  # file
bucket "photos".permissions = <none>  # default
bucket "photos".root_prefix = ""  # default
bucket "photos".max_scan_pages = 1  # default
bucket "photos".encryption = ""  # default
bucket "photos".quota_bytes = <none>  # default
volume "files".name = "Files"  # file
volume "files".path = "@DIR@/volume"  # file
volume "files".permissions = ["read"]  # file
volume "files".root_prefix = "shared/"  # file
volume "files".max_scan_pages = 1000000  # file
volume "-".name = "-"  # default
volume "-".path = "@DIR@/volume"  # file
volume "-".permissions = <none>  # default
volume "-".root_prefix = ""  # default
volume "-".max_scan_pages = 1  # default
